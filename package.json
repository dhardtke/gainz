{
  "name": "gainz",
  "version": "0.1.0",
  "private": true,
  "description": "Track weight-lifting progress: workouts, sets, reps, weight and notes.",
  "type": "module",
  "module": "src/backend/main.ts",
  "scripts": {
    "start": "bun run src/backend/main.ts",
    "start:dev": "GAINZ_DEV=1 bun --watch src/backend/main.ts",
    "seed": "bun run src/scripts/seed.ts",
    "migrate": "bun run src/scripts/migrate.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@picocss/pico": "2.1.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}

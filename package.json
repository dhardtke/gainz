{
  "name": "gainz",
  "version": "0.1.0",
  "private": true,
  "description": "Track weight-lifting progress: workouts, sets, reps, weight and notes.",
  "license": "MIT",
  "type": "module",
  "module": "src/backend/main.ts",
  "scripts": {
    "build": "bun run src/scripts/build.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "hash-password": "bun run src/scripts/hash-password.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "migrate": "bun run src/scripts/migrate.ts",
    "screenshots": "bun run src/scripts/screenshots.ts",
    "seed": "bun run src/scripts/seed.ts",
    "start": "bun run src/backend/main.ts",
    "start:dev": "GAINZ_DEV=1 bun --watch src/backend/main.ts",
    "test": "bun test --parallel",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@knadh/oat": "0.8.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "happy-dom": "20.14.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.2"
  }
}
